# Writes OUTPUT, a C++ source holding the browser client (JS and WASM files of
# an Emscripten build of ViewW/wasm) as byte arrays, so the viewer stays one
# self-contained executable. Run with cmake -P, passing OUTPUT, JS and WASM.

function(pyra_embed_bytes variable path name)
	file(READ "${path}" hex HEX)
	string(LENGTH "${hex}" digits)
	math(EXPR size "${digits} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	set(${variable} "extern const unsigned char ${name}[] = { ${bytes} };\nextern const size_t ${name}_size = ${size};\n" PARENT_SCOPE)
endfunction()

pyra_embed_bytes(js_source "${JS}" js)
pyra_embed_bytes(wasm_source "${WASM}" wasm)
file(WRITE "${OUTPUT}.tmp" "// Generated by ViewW/embed_client.cmake - do not edit.\n#include <cstddef>\nnamespace pyra::web::client_assets {\n${js_source}${wasm_source}}\n")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
